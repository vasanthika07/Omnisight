# =================================================================
# OmniSight Configuration
# =================================================================

# Vision Model Provider: 'auto', 'openai', 'gemini', or 'mock'
# If set to 'auto', OmniSight will use OpenAI or Gemini if a key is provided,
# or fallback smoothly to the built-in Intelligent Autonomous Vision Engine.
VISION_PROVIDER=auto

# Optional: Add your OpenAI API Key if you want to use GPT-4o / GPT-4o-mini
# OPENAI_API_KEY=sk-...

# Optional: Add your Google Gemini API Key if you want to use Gemini 1.5 Pro / Flash
# GEMINI_API_KEY=AIza...

# Optional: GitHub Personal Access Token for live automated Pull Requests
# GITHUB_TOKEN=ghp_...
# GITHUB_REPO=your-user/your-repo

# Server configuration
PORT=8000
HOST=127.0.0.1
TEST_APP_PORT=5174
